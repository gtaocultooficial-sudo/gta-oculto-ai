# Core persistence
GTA_WORKSPACE=/var/data/workspace
GTA_AUTONOMOUS_MODE=1
GTA_MAX_AUTONOMOUS_RECOVERIES=4

# Optional autonomous code deploy. Keep OFF until GitHub + Render secrets are configured.
GTA_AUTO_DEPLOY=0
GITHUB_TOKEN=
GITHUB_REPO=gtaocultooficial-sudo/gta-oculto-ai
GITHUB_BRANCH=main
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Optional YouTube publishing. Start with private until validated.
YOUTUBE_AUTO_PUBLISH=0
YOUTUBE_PRIVACY=private
YOUTUBE_TOKEN_JSON=
YOUTUBE_ANALYTICS_ENABLED=0

# Optional manual Higgsfield scene generation. Keep disabled until rotated credentials and guard token are set.
HIGGSFIELD_API_ENABLED=0
HIGGSFIELD_API_KEY=
HIGGSFIELD_ACTION_TOKEN=
